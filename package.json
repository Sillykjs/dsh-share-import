{
  "name": "dsh-share-import",
  "version": "0.1.0",
  "description": "Import a public chat.deepseek.com share link into a DSH workspace as a static, resumable session.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "import",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sillykjs/dsh-share-import.git"
  },
  "homepage": "https://github.com/Sillykjs/dsh-share-import#readme",
  "bugs": {
    "url": "https://github.com/Sillykjs/dsh-share-import/issues"
  },
  "author": "Sillykjs"
}
