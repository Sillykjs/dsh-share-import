{
  "name": "dsh-share-import",
  "version": "0.2.0",
  "description": "Import a public DeepSeek or Doubao chat share link into a DSH workspace as a static, resumable session.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/share.js && node --check lib/doubao.js && node --check lib/errors.js && node --check lib/events.js && node --check lib/formats.js && node --check lib/persistence.js && node --check lib/client.js",
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "doubao",
    "share",
    "import",
    "session",
    "chat-archive"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sillykjs/dsh-share-import.git"
  },
  "homepage": "https://github.com/Sillykjs/dsh-share-import#readme",
  "bugs": {
    "url": "https://github.com/Sillykjs/dsh-share-import/issues"
  },
  "author": "Sillykjs"
}
